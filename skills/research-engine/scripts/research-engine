#!/usr/bin/env python3
"""research-engine — durable question lifecycle for loop 06.03.

One JSON ledger, file-locked, one record per question. Stage A creates; Stage B
claims, researches, completes; the editor rejects or publishes. Every state
transition is idempotent so a retried cron run cannot duplicate a question, a
research claim, or a dispatch.

States: ready → researching → researched → published | rejected
                            ↘ failed (after N attempts)

Usage:
  research-engine create --title T --question-file F --discovery-file F [--slug S]
  research-engine claim [--wait SECONDS] [--json]
  research-engine complete --id ID --research-file F
  research-engine reject --id ID --reason S [--editorial-file F] [--score N]
  research-engine publish --id ID --slug S [--dispatch-id D] [--title T] [--url U]
  research-engine fail --id ID --reason S
  research-engine release --id ID
  research-engine reap
  research-engine reconcile --id ID
  research-engine status
  research-engine list [--state S]
  research-engine show --id ID

Exit codes: 0 ok · 1 usage/error · 2 no eligible question · 3 already exists
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

# The loop root holds state/questions.json and questions/<id>/. Point it at any
# writable directory: this CLI has no other coupling to the host.
LOOP = Path(
    os.environ.get(
        "RESEARCH_LOOP",
        os.environ.get("RESEARCH_ROOT", Path.home() / ".local" / "share" / "research-engine"),
    )
)
STATE_DIR = LOOP / "state"
LEDGER = STATE_DIR / "questions.json"
LOCK = STATE_DIR / ".lock"
TZ = ZoneInfo(os.environ.get("RESEARCH_TZ", "UTC"))
LEASE_HOURS = float(os.environ.get("RESEARCH_LEASE_HOURS", "6"))
MAX_ATTEMPTS = int(os.environ.get("RESEARCH_MAX_ATTEMPTS", "2"))



def _default_url(slug: str) -> str | None:
    """Where a published note lives. Only set when an Orbit base URL is configured."""
    base = os.environ.get("ORBIT_BASE_URL", "").rstrip("/")
    return f"{base}/notes/{slug}" if base else None


# ---------------------------------------------------------------- utilities --
def now() -> datetime:
    return datetime.now(TZ)


def iso(dt: datetime | None = None) -> str:
    return (dt or now()).isoformat(timespec="seconds")


def today() -> str:
    return now().date().isoformat()


def slugify(s: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:60] or "question"


class Locked:
    def __enter__(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.fh = open(LOCK, "a+")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def load() -> dict:
    if LEDGER.exists():
        try:
            return json.loads(LEDGER.read_text())
        except json.JSONDecodeError:
            sys.exit(f"research-engine: corrupt ledger {LEDGER}")
    return {"version": 1, "questions": []}


def save(data: dict) -> None:
    tmp = LEDGER.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(LEDGER)


def find(data: dict, qid: str) -> dict | None:
    return next((q for q in data["questions"] if q["id"] == qid), None)


def record_event(q: dict, event: str, **kw) -> None:
    q.setdefault("events", []).append({"at": iso(), "event": event, **kw})


def out(obj, as_json: bool) -> None:
    if as_json:
        print(json.dumps(obj, indent=2, ensure_ascii=False))
    else:
        for k, v in obj.items():
            print(f"{k}: {v}")


# ----------------------------------------------------------------- commands --
def cmd_create(a) -> int:
    title = a.title.strip()
    if not title:
        sys.exit("create: --title is required")
    qfile, dfile = Path(a.question_file), Path(a.discovery_file)
    for f in (qfile, dfile):
        if not f.is_file():
            sys.exit(f"create: missing {f}")
    slug = slugify(a.slug or title)
    qid = f"q-{today().replace('-', '')}-{slug}"

    with Locked():
        data = load()
        existing = find(data, qid)
        if existing:
            out({"status": "exists", "id": qid, "state": existing["state"]}, a.json)
            return 0
        # one question per day: refuse a second unless forced
        same_day = [q for q in data["questions"] if q["date"] == today()]
        if same_day and not a.force:
            print(f"create: {len(same_day)} question(s) already exist for {today()}", file=sys.stderr)
            return 3

        qdir = LOOP / "questions" / qid
        qdir.mkdir(parents=True, exist_ok=True)
        brief = qdir / "brief.md"
        brief.write_text(qfile.read_text())
        (qdir / "discovery.md").write_text(dfile.read_text())

        q = {
            "id": qid,
            "date": today(),
            "slug": slug,
            "title": title,
            "state": "ready",
            "created_at": iso(),
            "updated_at": iso(),
            "attempts": 0,
            "dir": str(qdir.relative_to(LOOP)),
            "brief": str(brief.relative_to(LOOP)),
            "research": None,
            "editorial": None,
            "score": None,
            "published": None,
            "reason": None,
        }
        record_event(q, "created")
        data["questions"].append(q)
        save(data)
        out({"status": "created", "id": qid, "state": "ready", "dir": str(qdir)}, a.json)
        return 0


def _due(q: dict, day: str) -> bool:
    """Only today's question is claimable — old questions never become today's job."""
    return q["state"] == "ready" and q["date"] == day


def cmd_claim(a) -> int:
    deadline = time.time() + max(0, a.wait)
    while True:
        with Locked():
            data = load()
            reap(data, save_it=False)
            cand = next((q for q in data["questions"] if _due(q, today())), None)
            if cand:
                cand["state"] = "researching"
                cand["attempts"] = cand.get("attempts", 0) + 1
                cand["claim"] = {
                    "at": iso(),
                    "lease_until": iso(now() + timedelta(hours=LEASE_HOURS)),
                    "run": f"runs/{cand['date']}/stage-b",
                }
                cand["updated_at"] = iso()
                record_event(cand, "claimed", attempt=cand["attempts"])
                save(data)
                out(
                    {
                        "status": "claimed",
                        "id": cand["id"],
                        "title": cand["title"],
                        "brief": str(LOOP / cand["brief"]),
                        "dir": str(LOOP / cand["dir"]),
                        "run": str(LOOP / cand["claim"]["run"]),
                        "attempt": cand["attempts"],
                    },
                    a.json,
                )
                return 0
            else:
                save(data)  # persist any reap
        if time.time() >= deadline:
            print("claim: no ready question for today", file=sys.stderr)
            return 2
        time.sleep(15)


def cmd_complete(a) -> int:
    f = Path(a.research_file)
    if not f.is_file():
        sys.exit(f"complete: missing {f}")
    with Locked():
        data = load()
        q = find(data, a.id) or sys.exit("complete: unknown id")
        if q["state"] == "researched" and q.get("research"):
            out({"status": "already-researched", "id": q["id"]}, a.json)
            return 0
        dest = LOOP / q["dir"] / "research.md"
        dest.write_text(f.read_text())
        q["state"] = "researched"
        q["research"] = str(dest.relative_to(LOOP))
        q["claim"] = None
        q["updated_at"] = iso()
        record_event(q, "researched")
        save(data)
        out({"status": "researched", "id": q["id"], "research": str(dest)}, a.json)
        return 0


def cmd_reject(a) -> int:
    with Locked():
        data = load()
        q = find(data, a.id) or sys.exit("reject: unknown id")
        if q["state"] == "rejected":
            out({"status": "already-rejected", "id": q["id"]}, a.json)
            return 0
        if a.editorial_file and Path(a.editorial_file).is_file():
            dest = LOOP / q["dir"] / "editorial.md"
            dest.write_text(Path(a.editorial_file).read_text())
            q["editorial"] = str(dest.relative_to(LOOP))
        q["state"] = "rejected"
        q["score"] = a.score if a.score is not None else q.get("score")
        q["reason"] = a.reason
        q["updated_at"] = iso()
        record_event(q, "rejected", reason=a.reason, score=q.get("score"))
        save(data)
        out({"status": "rejected", "id": q["id"]}, a.json)
        return 0


def cmd_publish(a) -> int:
    with Locked():
        data = load()
        q = find(data, a.id) or sys.exit("publish: unknown id")
        if q["state"] == "published":
            out({"status": "already-published", "id": q["id"], "slug": q["published"]["slug"]}, a.json)
            return 0
        q["state"] = "published"
        q["score"] = a.score if a.score is not None else q.get("score")
        q["published"] = {
            "slug": a.slug,
            "dispatch_id": a.dispatch_id,
            "title": a.title or q["title"],
            "url": a.url or _default_url(a.slug),
            "at": iso(),
        }
        q["updated_at"] = iso()
        record_event(q, "published", slug=a.slug)
        save(data)
        out({"status": "published", "id": q["id"], "url": q["published"]["url"]}, a.json)
        return 0


def cmd_fail(a) -> int:
    with Locked():
        data = load()
        q = find(data, a.id) or sys.exit("fail: unknown id")
        q["state"] = "failed"
        q["reason"] = a.reason
        q["claim"] = None
        q["updated_at"] = iso()
        record_event(q, "failed", reason=a.reason)
        save(data)
        out({"status": "failed", "id": q["id"]}, a.json)
        return 0


def cmd_release(a) -> int:
    with Locked():
        data = load()
        q = find(data, a.id) or sys.exit("release: unknown id")
        q["state"] = "ready"
        q["claim"] = None
        q["updated_at"] = iso()
        record_event(q, "released")
        save(data)
        out({"status": "ready", "id": q["id"]}, a.json)
        return 0


def reap(data: dict, save_it: bool = True) -> list[str]:
    """Expired claims go back to ready (or failed after MAX_ATTEMPTS)."""
    changed = []
    for q in data["questions"]:
        if q["state"] != "researching" or not q.get("claim"):
            continue
        if q["claim"]["lease_until"] <= iso():
            changed.append(q["id"])
            if q.get("attempts", 0) >= MAX_ATTEMPTS:
                q["state"] = "failed"
                q["reason"] = "lease expired after max attempts"
            else:
                q["state"] = "ready"
            q["claim"] = None
            q["updated_at"] = iso()
            record_event(q, "lease-expired", new_state=q["state"])
    if save_it and changed:
        save(data)
    return changed


def cmd_reap(a) -> int:
    with Locked():
        data = load()
        changed = reap(data)
        out({"status": "reaped", "changed": changed}, a.json)
    return 0


def cmd_reconcile(a) -> int:
    """If Orbit says published but the local ack was lost, close the gap."""
    with Locked():
        data = load()
        q = find(data, a.id) or sys.exit("reconcile: unknown id")
        slug = (q.get("published") or {}).get("slug") or a.slug
        if not slug:
            sys.exit("reconcile: no slug on record; pass --slug")
    try:
        raw = subprocess.run(
            ["orbit", "dispatch", "show", slug, "--json"],
            capture_output=True, text=True, timeout=60,
        )
        d = json.loads(raw.stdout or "{}")
        x = d.get("dispatch") or d
        status = (x.get("status") or "").lower()
        if status == "published":
            with Locked():
                data = load()
                q = find(data, a.id)
                q["state"] = "published"
                q["published"] = {
                    "slug": x.get("slug") or slug,
                    "dispatch_id": x.get("id"),
                    "title": x.get("title"),
                    "url": _default_url(x.get("slug") or slug),
                    "at": iso(),
                }
                q["updated_at"] = iso()
                record_event(q, "reconciled-published")
                save(data)
            out({"status": "reconciled", "id": a.id, "dispatch": status}, a.json)
            return 0
        out({"status": "not-published", "id": a.id, "dispatch": status or "unknown"}, a.json)
        return 2
    except Exception as e:  # noqa: BLE001
        print(f"reconcile: orbit lookup failed: {e}", file=sys.stderr)
        return 1


def cmd_status(a) -> int:
    data = load()
    counts: dict[str, int] = {}
    for q in data["questions"]:
        counts[q["state"]] = counts.get(q["state"], 0) + 1
    ready = [q["id"] for q in data["questions"] if _due(q, today())]
    out(
        {
            "ledger": str(LEDGER),
            "questions": len(data["questions"]),
            "counts": counts,
            "claimable_today": ready,
            "today": today(),
        },
        True,
    )
    return 0


def cmd_list(a) -> int:
    data = load()
    for q in sorted(data["questions"], key=lambda x: x["created_at"], reverse=True):
        if a.state and q["state"] != a.state:
            continue
        print(f"{q['date']}\t{q['state']}\t{q['id']}\t{q['title'][:90]}")
    return 0


def cmd_show(a) -> int:
    data = load()
    q = find(data, a.id) or sys.exit("show: unknown id")
    print(json.dumps(q, indent=2, ensure_ascii=False))
    return 0


# -------------------------------------------------------------------- main --
def main() -> int:
    p = argparse.ArgumentParser(prog="research-engine", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("create"); c.add_argument("--title", required=True)
    c.add_argument("--question-file", required=True); c.add_argument("--discovery-file", required=True)
    c.add_argument("--slug"); c.add_argument("--force", action="store_true"); c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_create)

    c = sub.add_parser("claim"); c.add_argument("--wait", type=int, default=0); c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_claim)

    c = sub.add_parser("complete"); c.add_argument("--id", required=True)
    c.add_argument("--research-file", required=True); c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_complete)

    c = sub.add_parser("reject"); c.add_argument("--id", required=True)
    c.add_argument("--reason", required=True); c.add_argument("--editorial-file")
    c.add_argument("--score", type=int); c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_reject)

    c = sub.add_parser("publish"); c.add_argument("--id", required=True)
    c.add_argument("--slug", required=True); c.add_argument("--dispatch-id")
    c.add_argument("--title"); c.add_argument("--url"); c.add_argument("--score", type=int)
    c.add_argument("--json", action="store_true"); c.set_defaults(fn=cmd_publish)

    c = sub.add_parser("fail"); c.add_argument("--id", required=True)
    c.add_argument("--reason", required=True); c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_fail)

    c = sub.add_parser("release"); c.add_argument("--id", required=True); c.add_argument("--json", action="store_true")
    c.set_defaults(fn=cmd_release)

    c = sub.add_parser("reap"); c.add_argument("--json", action="store_true"); c.set_defaults(fn=cmd_reap)

    c = sub.add_parser("reconcile"); c.add_argument("--id", required=True)
    c.add_argument("--slug"); c.add_argument("--json", action="store_true"); c.set_defaults(fn=cmd_reconcile)

    c = sub.add_parser("status"); c.set_defaults(fn=cmd_status)
    c = sub.add_parser("list"); c.add_argument("--state"); c.set_defaults(fn=cmd_list)
    c = sub.add_parser("show"); c.add_argument("--id", required=True); c.set_defaults(fn=cmd_show)

    a = p.parse_args()
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
